# Ghostty config. Syntax: `key = value`, comments start with '#'.
# Reference: https://ghostty.org/docs/config
#
# Check this file after install:  ghostty +validate-config
# (that subcommand is from memory; if it does not exist, `ghostty +show-config`
# or the log printed when you launch ghostty from another terminal will show
# unknown keys.)
#
# VERIFIED against Ghostty's docs page: key = value syntax, font-family,
# font-size, window-padding-x/y, theme, keybind syntax.
# FROM MEMORY, not re-checked: the rest. Any unknown key is reported at start.

font-family = JetBrainsMono Nerd Font
font-size = 11.5

background-opacity = 0.93
window-padding-x = 8
window-padding-y = 8
confirm-close-surface = false
window-decoration = false
cursor-style = block
cursor-style-blink = false

# Colours: Tokyo Night style, same as quickshell/themes/Theme.qml.
background = 14161b
foreground = d8dee9
selection-background = 7aa2f7
selection-foreground = 14161b
cursor-color = 7aa2f7

palette = 0=#1c1f26
palette = 1=#f7768e
palette = 2=#9ece6a
palette = 3=#e0af68
palette = 4=#7aa2f7
palette = 5=#bb9af7
palette = 6=#7dcfff
palette = 7=#a9b1d6
palette = 8=#414868
palette = 9=#f7768e
palette = 10=#9ece6a
palette = 11=#e0af68
palette = 12=#7aa2f7
palette = 13=#bb9af7
palette = 14=#7dcfff
palette = 15=#d8dee9

# Copy/paste. Ctrl+Shift only, so nothing collides with Hyprland's Super binds.
keybind = ctrl+shift+c=copy_to_clipboard
keybind = ctrl+shift+v=paste_from_clipboard
