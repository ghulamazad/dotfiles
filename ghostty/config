# Ghostty config. Syntax: `key = value`, comments start with '#'.
# Reference: https://ghostty.org/docs/config
#
# Configured to match Omarchy's Ghostty look and feel (Inventory §2, §10).

# Font
font-family = VictorMono Nerd Font
font-size = 12

# Window
background-opacity = 1
window-padding-x = 0
window-padding-y = 0
confirm-close-surface = false
window-decoration = false
resize-overlay = never
gtk-toolbar-style = flat

# Cursor styling
cursor-style = block
cursor-style-blink = false

# Mouse & Performance (epoll fix for Hyprland from Omarchy)
mouse-scroll-multiplier = 0.95
async-backend = epoll

# Colours: Deep obsidian plum & sage jade palette
background = 150f1d
foreground = c6bdce
selection-background = 295d50
selection-foreground = f0faf4
cursor-color = 7db6a7

palette = 0=#1a1323
palette = 1=#d88d91
palette = 2=#81beae
palette = 3=#d7ba7d
palette = 4=#7db6a7
palette = 5=#b7a1c8
palette = 6=#78b0a2
palette = 7=#c6bdce
palette = 8=#4f4657
palette = 9=#e6a6aa
palette = 10=#9fbc79
palette = 11=#e8cca0
palette = 12=#8bcbb1
palette = 13=#cfbce0
palette = 14=#a2dcda
palette = 15=#f0faf4

# Copy/paste. Ctrl+Shift only, so nothing collides with Hyprland's Super binds.
keybind = ctrl+shift+c=copy_to_clipboard
keybind = ctrl+shift+v=paste_from_clipboard
